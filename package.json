{
  "name": "mini-crm-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "node --env-file=.dev.vars scripts/migrate.mjs",
    "db:seed": "node --env-file=.dev.vars scripts/seed.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/**/*Unit.test.ts",
    "test:system": "vitest run tests/**/*System.test.ts",
    "lint": "eslint src frontend scripts tests *.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.frontend.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@lucide/vue": "^1.49.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.143.0"
  }
}
