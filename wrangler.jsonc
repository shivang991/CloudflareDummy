{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflaredummy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/openapi.json", "/docs"],
  },
  "secrets": {
    "required": ["DATABASE_URL", "GOOGLE_CLIENT_ID"],
  },
}
